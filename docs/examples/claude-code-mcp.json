{
  "mcpServers": {
    "foga": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@finchip/foga", "mcp", "--config", "/home/me/cells/D.json"],
      "env": {
        "FOGA_OPERATOR_KEY_FILE": "/home/me/.foga/keys/operator.key",
        "FOGA_RPC_URL": "http://127.0.0.1:8545"
      }
    }
  }
}
