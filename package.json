{
  "name": "foga",
  "version": "0.5.0-alpha.5",
  "repository": {
    "type": "git",
    "url": "https://github.com/garyyang-finchip/foga.git"
  },
  "homepage": "https://github.com/garyyang-finchip/foga#readme",
  "description": "Finch OG Agent (FOGA): world builder, conformance doctor, cell kernel and genesis scenario for the ten-ERC agent stack (ERC-8338/8414/8419/8434/8436/8444/8447/8454/8468/8471)",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "foga": "./bin/foga.js"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "bin",
    "dist",
    "artifacts",
    "worlds",
    "scenarios",
    "prover/package.json",
    "prover/package-lock.json",
    "prover/run.cjs",
    "prover/README.md",
    "prover/build-predicate.mjs",
    "zk/circuits",
    "zk/build/verification_key.json",
    "build/profiles.json",
    "build/known-interface-ids.json",
    "vendor/LOCK.json",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "foga": "tsx src/cli.ts",
    "vendor:sync": "tsx src/cli.ts vendor sync",
    "bundle": "tsx src/cli.ts build",
    "bundle:verify": "tsx src/cli.ts build --verify",
    "world:local": "tsx src/cli.ts world deploy --world worlds/local.json --out deployments/local.json",
    "doctor:local": "tsx src/cli.ts doctor --world deployments/local.json --out deployments/local.doctor.json",
    "demo": "tsx src/cli.ts demo",
    "demo:genesis": "tsx src/cli.ts demo --genesis T9",
    "genesis:local": "tsx src/cli.ts genesis run --world deployments/local.json --until T9",
    "rehearse:attach": "bash scripts/rehearse-attach.sh",
    "test": "node --test --import tsx test/*.test.ts",
    "test:contracts": "cd contracts && forge test -vv",
    "zk:install": "npm --prefix prover ci",
    "zk:predicate": "node prover/build-predicate.mjs"
  },
  "dependencies": {
    "ethers": "6.17.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
