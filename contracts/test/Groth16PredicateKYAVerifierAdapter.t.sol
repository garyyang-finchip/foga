pragma solidity ^0.8.24;

import {Groth16PredicateKYAVerifierAdapter} from "../src/zk/Groth16PredicateKYAVerifierAdapter.sol";

/// Minimal cheatcode surface so the test needs no external library.
interface Vm {
    function warp(uint256 newTimestamp) external;
    function expectRevert(bytes calldata revertData) external;
    function expectRevert() external;
}

/// A Groth16 verifier stand-in: answers `true` only when the public-signal vector it is given equals the one the
/// test expects (set beforehand), so the adapter's signal layout is checked without a proving key. The real
/// verifier (src/zk/Groth16PredicateVerifier.sol, generated by snarkjs) is exercised by the genesis against proofs
/// made with the development proving key; here the adapter's own logic is under test.
contract ExpectingVerifier {
    bool public answer = true;
    uint256[17] public expected;

    function setAnswer(bool a) external {
        answer = a;
    }

    function setExpected(uint256[17] calldata e) external {
        for (uint256 i = 0; i < 17; i++) expected[i] = e[i];
    }

    function verifyProof(uint256[2] calldata, uint256[2][2] calldata, uint256[2] calldata, uint256[17] calldata input)
        external
        view
        returns (bool)
    {
        for (uint256 i = 0; i < 17; i++) if (input[i] != expected[i]) return false;
        return answer;
    }
}

contract Groth16PredicateKYAVerifierAdapterTest {
    Vm constant vm = Vm(address(uint160(uint256(keccak256("hevm cheat code")))));

    uint64 constant EPOCH_LENGTH = 2_592_000; // 30 days, as the genesis uses
    uint64 constant GRACE = 1;
    uint64 constant VALIDITY = 7 days;
    uint256 constant NOW = 1_800_000_000;

    ExpectingVerifier g;
    Groth16PredicateKYAVerifierAdapter adapter;
    bytes32 root = keccak256("source set root");
    bytes32 schemeId = keccak256("scheme");
    bytes32 domain = keccak256("admission domain");
    bytes proof = abi.encode([uint256(1), 2], [[uint256(3), 4], [uint256(5), 6]], [uint256(7), 8]);

    function setUp() public {
        vm.warp(NOW);
        g = new ExpectingVerifier();
        adapter = new Groth16PredicateKYAVerifierAdapter(address(g), root, EPOCH_LENGTH, GRACE, VALIDITY);
    }

    function _pub() internal view returns (Groth16PredicateKYAVerifierAdapter.Pub memory p) {
        p.subjectKey = keccak256("subject");
        p.nullifier = bytes32(uint256(keccak256("nullifier")) >> 4); // a field element: top bits clear
        p.challenge = keccak256("challenge");
        p.t0 = 1_700_000_000;
        p.t1 = 1_799_999_999;
        p.k = 3;
        p.sourceSetRoot = root;
        p.epoch = adapter.currentEpoch();
        p.result = 1;
    }

    /// The signal vector the adapter must hand the verifier for (schemeId, domain, p), built independently of
    /// `adapter.signals` so the two are cross-checked.
    function _expected(Groth16PredicateKYAVerifierAdapter.Pub memory p) internal view returns (uint256[17] memory e) {
        (e[0], e[1]) = (_hi(p.nullifier), _lo(p.nullifier));
        e[2] = p.result;
        (e[3], e[4]) = (_hi(p.subjectKey), _lo(p.subjectKey));
        (e[5], e[6]) = (_hi(p.challenge), _lo(p.challenge));
        (e[7], e[8], e[9]) = (p.t0, p.t1, p.k);
        (e[10], e[11]) = (_hi(p.sourceSetRoot), _lo(p.sourceSetRoot));
        (e[12], e[13]) = (_hi(schemeId), _lo(schemeId));
        e[14] = p.epoch;
        (e[15], e[16]) = (_hi(domain), _lo(domain));
    }

    function _arm(Groth16PredicateKYAVerifierAdapter.Pub memory p) internal {
        g.setExpected(_expected(p));
    }

    function _enc(Groth16PredicateKYAVerifierAdapter.Pub memory p) internal pure returns (bytes memory) {
        return abi.encode(p.subjectKey, p.nullifier, p.challenge, p.t0, p.t1, p.k, p.sourceSetRoot, p.epoch, p.result);
    }

    function _hi(bytes32 v) internal pure returns (uint256) {
        return uint256(v) >> 128;
    }

    function _lo(bytes32 v) internal pure returns (uint256) {
        return uint256(v) & ((uint256(1) << 128) - 1);
    }

    function testVerifiedProofMapsToLevelOne() public {
        Groth16PredicateKYAVerifierAdapter.Pub memory p = _pub();
        _arm(p);
        (bool ok, bytes32 subjectKey, bytes32 nullifier, uint8 level, bytes32 claimDigest, uint64 expiresAt, bytes32 anchor) =
            adapter.verify(schemeId, domain, _enc(p), proof);
        require(ok, "ok");
        require(subjectKey == p.subjectKey && nullifier == p.nullifier, "subject/nullifier pass through");
        require(level == 1, "level 1");
        require(claimDigest == keccak256(abi.encode(p.challenge, p.t0, p.t1, p.k, p.sourceSetRoot)), "claimDigest commits to the rule");
        require(expiresAt == uint64(NOW) + VALIDITY, "expiry from validity");
        require(anchor == root, "anchor is the source set root");
    }

    function testSignalOrderMatchesTheCircuit() public {
        Groth16PredicateKYAVerifierAdapter.Pub memory p = _pub();
        uint256[17] memory e = _expected(p);
        uint256[17] memory got = adapter.signals(schemeId, domain, p);
        for (uint256 i = 0; i < 17; i++) require(got[i] == e[i], "signals() order");
        // any single signal off by one makes the verifier say no: the adapter passes exactly this vector
        for (uint256 i = 0; i < 17; i++) {
            uint256[17] memory off = e;
            off[i] += 1;
            g.setExpected(off);
            (bool ok,,,,,,) = adapter.verify(schemeId, domain, _enc(p), proof);
            require(!ok, "mismatching signal rejected");
        }
        _arm(p);
        (bool ok2,,,,,,) = adapter.verify(schemeId, domain, _enc(p), proof);
        require(ok2, "exact vector accepted");
    }

    function testRejectedProofReturnsFalseAndZeros() public {
        g.setAnswer(false);
        Groth16PredicateKYAVerifierAdapter.Pub memory p = _pub();
        _arm(p);
        (bool ok, bytes32 subjectKey, bytes32 nullifier, uint8 level, bytes32 claimDigest, uint64 expiresAt, bytes32 anchor) =
            adapter.verify(schemeId, domain, _enc(p), proof);
        require(!ok && subjectKey == 0 && nullifier == 0 && level == 0 && claimDigest == 0 && expiresAt == 0 && anchor == 0, "zeros");
    }

    function testFalsePredicateIsNotRecorded() public {
        Groth16PredicateKYAVerifierAdapter.Pub memory p = _pub();
        p.result = 0;
        vm.expectRevert(abi.encodeWithSelector(Groth16PredicateKYAVerifierAdapter.PredicateNotSatisfied.selector));
        adapter.verify(schemeId, domain, _enc(p), proof);
        p.result = 2;
        vm.expectRevert(abi.encodeWithSelector(Groth16PredicateKYAVerifierAdapter.InvalidResult.selector, uint8(2)));
        adapter.verify(schemeId, domain, _enc(p), proof);
    }

    function testPinnedSourceSetRoot() public {
        Groth16PredicateKYAVerifierAdapter.Pub memory p = _pub();
        p.sourceSetRoot = keccak256("another set");
        vm.expectRevert(abi.encodeWithSelector(Groth16PredicateKYAVerifierAdapter.SourceSetRootMismatch.selector, root, p.sourceSetRoot));
        adapter.verify(schemeId, domain, _enc(p), proof);

        Groth16PredicateKYAVerifierAdapter any = new Groth16PredicateKYAVerifierAdapter(address(g), bytes32(0), EPOCH_LENGTH, GRACE, VALIDITY);
        _arm(p);
        (bool ok,,,,,, bytes32 anchor) = any.verify(schemeId, domain, _enc(p), proof);
        require(ok && anchor == p.sourceSetRoot, "unpinned adapter returns the proof's root as anchor");
    }

    function testEpochWindow() public {
        Groth16PredicateKYAVerifierAdapter.Pub memory p = _pub();
        uint64 cur = adapter.currentEpoch();
        require(cur == uint64(NOW / EPOCH_LENGTH), "current epoch");

        p.epoch = cur - GRACE;
        _arm(p);
        (bool ok,,,,,,) = adapter.verify(schemeId, domain, _enc(p), proof);
        require(ok, "previous epoch within grace");

        p.epoch = cur + 1;
        vm.expectRevert(abi.encodeWithSelector(Groth16PredicateKYAVerifierAdapter.EpochOutOfWindow.selector, cur, GRACE, cur + 1));
        adapter.verify(schemeId, domain, _enc(p), proof);

        p.epoch = cur - GRACE - 1;
        vm.expectRevert(abi.encodeWithSelector(Groth16PredicateKYAVerifierAdapter.EpochOutOfWindow.selector, cur, GRACE, cur - GRACE - 1));
        adapter.verify(schemeId, domain, _enc(p), proof);
    }

    function testEpochLengthZeroRequiresEpochZero() public {
        Groth16PredicateKYAVerifierAdapter a0 = new Groth16PredicateKYAVerifierAdapter(address(g), root, 0, 0, 0);
        Groth16PredicateKYAVerifierAdapter.Pub memory p = _pub();
        p.epoch = 0;
        _arm(p);
        (bool ok,,,,, uint64 expiresAt,) = a0.verify(schemeId, domain, _enc(p), proof);
        require(ok && expiresAt == 0, "epoch 0 accepted; validity 0 means no expiry");
        p.epoch = 1;
        vm.expectRevert(abi.encodeWithSelector(Groth16PredicateKYAVerifierAdapter.EpochOutOfWindow.selector, uint64(0), uint64(0), uint64(1)));
        a0.verify(schemeId, domain, _enc(p), proof);
    }

    function testEmptyWindowRejected() public {
        Groth16PredicateKYAVerifierAdapter.Pub memory p = _pub();
        p.t0 = p.t1 + 1;
        vm.expectRevert(abi.encodeWithSelector(Groth16PredicateKYAVerifierAdapter.EmptyWindow.selector, p.t0, p.t1));
        adapter.verify(schemeId, domain, _enc(p), proof);
    }

    function testDecodeRoundTrip() public view {
        Groth16PredicateKYAVerifierAdapter.Pub memory p = _pub();
        Groth16PredicateKYAVerifierAdapter.Pub memory q = adapter.decode(_enc(p));
        require(
            q.subjectKey == p.subjectKey && q.nullifier == p.nullifier && q.challenge == p.challenge && q.t0 == p.t0 && q.t1 == p.t1
                && q.k == p.k && q.sourceSetRoot == p.sourceSetRoot && q.epoch == p.epoch && q.result == p.result,
            "decode"
        );
    }
}
