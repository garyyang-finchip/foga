# dependencies and build output
node_modules/
prover/node_modules/
dist/
out/
cache/
.foga-build/

# vendored upstream sources are materialized by `foga vendor sync` from vendor/LOCK.json
vendor/*/
!vendor/LOCK.json
!vendor/README.md

# local world outputs (keep the committed examples)
deployments/*.json
!deployments/*.example.json
deployments/*.sqlite
deployments/*.sqlite-*
# cells born locally (foga cell new / init): configs, stores and inline documents; the OG cell's published files live under deployments/og/
deployments/cells/
# loop D working files (foga demo --loop-d): the cell's config and store, the demander's store, transcripts
deployments/loop-d/

# foundry
contracts/out/
contracts/cache/

# misc
.env
*.log
.DS_Store

# predicate circuit build output (prover/build-predicate.mjs); the verification key is committed, the rest rebuilt
zk/build/*
!zk/build/verification_key.json
