{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foga.local/schemas/probe.schema.json",
  "title": "foga.probe/1 report",
  "type": "object",
  "required": ["schema", "skill", "world", "subject", "checks"],
  "properties": {
    "schema": { "const": "foga.probe/1" },
    "skill": { "const": "foga-probe" },
    "world": {
      "type": "object",
      "required": ["worldId", "chainId", "block", "blockHash"],
      "properties": {
        "worldId": { "type": "string" },
        "chainId": { "type": "integer" },
        "block": { "type": "integer" },
        "blockHash": { "type": "string" }
      }
    },
    "subject": { "type": "string", "description": "CAIP-10 account reference, lower-case" },
    "checks": {
      "type": "object",
      "required": ["erc8004", "erc8434", "erc8419", "erc8468", "erc8444", "erc8454", "erc8338", "erc8414", "erc8447", "erc8436", "erc8471"],
      "additionalProperties": false,
      "properties": {
        "erc8004": { "type": ["object", "null"] },
        "erc8434": { "type": ["object", "null"] },
        "erc8419": { "type": ["object", "null"] },
        "erc8468": { "type": ["object", "null"] },
        "erc8444": { "type": ["object", "null"] },
        "erc8454": { "type": ["object", "null"] },
        "erc8338": { "type": ["object", "null"] },
        "erc8414": { "type": ["object", "null"] },
        "erc8447": { "type": ["object", "null"] },
        "erc8436": { "type": ["object", "null"] },
        "erc8471": { "type": ["object", "null"] }
      }
    }
  }
}
